{
  "metadata": {
    "name": "PD-id-registry",
    "version": "1.0",
    "created": "2026-03-24",
    "updated": "2026-05-18",
    "description": "Product Documentation ID Registry - project-specific document IDs",
    "format": "semantic",
    "axis_note": "Prefix entries store category = documentation tree and type = document kind — transposed relative to document frontmatter, which stores type = tree and category = kind. Never copy values across without swapping the axes.",
    "id_gaps_policy": "Gaps in ID sequences are expected and never backfilled: an ID stays with its artifact for life — never reassign, renumber, or reuse a deleted artifact's ID (archives and history may still reference it). This constrains IDs, not the pool's nextAvailable counter, which must stay above every ID issued in this tree and never drops just because artifacts were deleted — EXCEPT reset it to 1 when the pool holds zero artifacts and none of its IDs are still referenced here (population migrated, retired, or blueprint seed only), or the vacated range is burned here and, for blueprint copies, in every project bootstrapped later. Projects that already grew their counter keep it."
  },
  "prefixes": {
    "PD-DOC": {
      "description": "Product Documentation - Documentation",
      "category": "Product Documentation",
      "type": "Documentation",
      "directories": {
        "founding": "doc/founding",
        "main": "doc",
        "default": "main"
      },
      "notes": "Two reserved singletons, both blueprint-shipped stubs pinned directly rather than allocated from nextAvailable (same convention as PD-UIX-001): PD-DOC-001 is the project's Product Concept (doc/founding/product-concept.md, from PF-TEM-086), synthesized by Project Initiation from doc/founding/inputs/; PD-DOC-002 is the Feature Landscape (doc/founding/feature-landscape.md, from PF-TEM-087), the discovery-cycle rationale record filled by Feature Discovery. PD-DOC-000 is the blueprint-shipped doc/README.md, likewise pinned below the counter. nextAvailable starts at 3 so no later PD-DOC allocation collides with a reserved slot. Founding INPUTS (raw human material under doc/founding/inputs/) deliberately receive NO IDs - the framework does not own them, they carry no frontmatter, and the directory is excluded from the PD documentation map; the Product Concept's Sources section indexes them by path instead. Projects onboarded before this convention shipped keep their existing PD-DOC assignments (grandfathered - the id_gaps_policy above forbids reassignment).",
      "nextAvailable": 3
    },
    "PD-MAI": {
      "description": "Product Documentation - Main/Index (singleton: PD-documentation-map.md). Parallel to PF-MAI for the framework documentation map.",
